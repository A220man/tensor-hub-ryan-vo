# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tensor_hub.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC/Keycloak (optional)
OIDC_ENABLED=false
OIDC_AUTHORITY=http://localhost:8080/realms/tensor-hub
OIDC_CLIENT_ID=tensor-hub
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_SCOPES=openid profile email roles

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Frontend
FRONTEND_URL=http://localhost:5173

# Debug
DEBUG=true